# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
target/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Env / secrets
.env
.env.*
!.env.example
*.dev.vars
.dev.vars

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Cloudflare Workers / wrangler local runtime state (miniflare KV, tmp bundles,
# dev sessions) — regenerated on every `wrangler dev`; never commit.
.wrangler/

# Temp media artifacts (worker/client scratch)
*.tmp
dummy.mp4

# Stray FFmpeg binaries stay ignored, EXCEPT the pinned Tauri sidecar under
# src-tauri, which is committed via Git LFS (see .gitattributes +
# scripts/provision-ffmpeg.mjs). The sidecar is checksum-verified on build.
ffmpeg-*.exe
!/apps/client/src-tauri/ffmpeg-*.exe
