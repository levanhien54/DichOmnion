# OmniVoice GPU Worker — mẫu biến môi trường (SAO chép sang .env; KHÔNG commit .env thật).
# Worker CHỈ giữ PUBLIC key của Gateway (bất đối xứng ES256) — không có bí mật ký nào ở đây.
# Sinh khoá bằng: scripts/gen-gateway-keys.sh (in ra đúng cặp giá trị bên dưới).

# --- TRẠM 2: xác minh JWT bất đối xứng từ Gateway ---------------------------------
# SPKI PEM khoá CÔNG KHAI của Gateway. BẮT BUỘC — thiếu thì /api/worker/process trả 503
# (fail-closed: worker không tin ai khi chưa được cấp khoá). Giá trị là PEM NHIỀU DÒNG,
# gồm cả dòng -----BEGIN/END PUBLIC KEY-----. Trên RunPod/Modal đặt dạng secret nhiều dòng;
# nếu dùng file .env qua python-dotenv, bọc trong nháy kép và giữ xuống dòng thật.
GATEWAY_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
<dán SPKI PEM ở đây — xem scripts/gen-gateway-keys.sh>
-----END PUBLIC KEY-----"

# --- Mạng / bind ------------------------------------------------------------------
# Mặc định loopback (an toàn). Trong container đặt 0.0.0.0 để cloudflared/orchestrator
# tới được; KHÔNG mở IP public trực tiếp — Gateway (qua tunnel) là đầu vào hợp lệ duy nhất.
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
# CORS nội bộ; để trống sẽ dùng danh sách mặc định (localhost:1420/5173, tauri://localhost...).
WORKER_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost,https://tauri.localhost
# Hàng đợi 1-job cho MỘT GPU 24GB (Whisper + Qwen đã thường trú). Chỉ nới khi lên GPU lớn hơn.
WORKER_MAX_CONCURRENT_JOBS=1
# Bật (=1) để in traceback ĐẦY ĐỦ ra STDERR khi debug trên hộp GPU — KHÔNG đi vào HTTP/KV.
# Để TRỐNG ở production (Zero-Logging).
WORKER_DEBUG=

# --- Dịch cục bộ (Qwen thường trú VRAM) -------------------------------------------
QWEN_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
QWEN_MAX_NEW_TOKENS=4096
# Self-review (Qwen tự chấm 1-5 + tự viết lại, ADVISORY thuần — KHÔNG phải cổng chấp nhận,
# KHÔNG log nội dung). MẶC ĐỊNH BẬT. Đặt 0/false/no/off để TẮT hoàn toàn (không thêm lần
# _generate nào → nhanh hơn/rẻ hơn nhưng bỏ vòng tinh chỉnh lip-sync).
QWEN_SELF_REVIEW=1
# Trần CỨNG số vòng self-review mỗi job (mặc định 2). <=0 cũng tắt self-review.
QWEN_MAX_REVIEW_ROUNDS=2
# Nơi chứa trọng số đã tải sẵn. Ảnh Docker bake sẵn hoặc mount volume vào đây.
HF_HOME=/models/hf
# Ép offline: worker KHÔNG được gọi ra HF Hub lúc chạy (nạp lười từ mạng = rò rỉ + phi
# xác định). translation_service đã setdefault =1; đặt tường minh ở đây cho rõ ý định.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# --- Tách nhạc nền (Demucs) -------------------------------------------------------
# Ép Demucs chạy trên GPU + chặn trần VRAM (xem audio_engine.extract_instrumental).
DEMUCS_DEVICE=cuda
DEMUCS_SEGMENT=7

# --- TTS nhân bản giọng cục bộ (TÙY CHỌN) -----------------------------------------
# edge-tts gửi VĂN BẢN DỊCH ra Microsoft cloud (exfiltration nội dung). Muốn giữ mọi thứ
# cục bộ (đúng Zero-Logging) thì chạy GPT-SoVITS và trỏ URL vào đây; client chọn
# voice="gpt-sovits" để dùng.
GPT_SOVITS_URL=http://127.0.0.1:9880

# CỔNG RIÊNG TƯ cho TTS ĐÁM MÂY. MẶC ĐỊNH TẮT (fail-closed): khi TẮT, đường edge-tts sẽ
# KHÔNG gửi bản dịch ra Microsoft — câu đó coi như không lồng được (worker báo trung thực
# số câu mất tiếng). Chỉ đặt =1 nếu bạn CHẤP NHẬN gửi văn bản ra cloud (vd dev/test không
# có GPT-SoVITS). Production nên để TRỐNG và dùng GPT-SoVITS cục bộ.
OMNIVOICE_ALLOW_CLOUD_TTS=

# --- Chặn tải audio (DoS) + vòng đời file đầu ra (Zero-Logging) --------------------
# Trần dung lượng audio worker chịu tải về từ presigned GET (Gateway ký mỗi job) (SSRF/DoS guard).
# Mặc định 1 GiB = 1073741824 (audio_service.py). Quá ngưỡng → từ chối, không tải tiếp.
WORKER_MAX_DOWNLOAD_BYTES=1073741824
# Thời gian (giây) giữ file audio ĐÃ RENDER trước khi reaper xoá (model_manager.py). Mặc
# định 3600 = 1 giờ. Giảm để rút ngắn thời gian dữ liệu người dùng tồn tại trên đĩa Pod.
WORKER_FINAL_TTL_S=3600

# --- Trần đầu vào (input-DoS, fail-closed → 422) ----------------------------------
# Các trần này chặn payload phình to trước khi vào tokenizer/pipeline; vượt ngưỡng nào →
# worker trả 422 (Gateway phản chiếu cùng ngưỡng, trả 400). Mặc định khớp main.py.
# Chỉ nới nếu THỰC SỰ cần xử lý video/kịch bản rất dài và đã hiểu chi phí VRAM/thời gian.
WORKER_MAX_SEGMENTS=2000                 # số segment tối đa mỗi job (main.py)
WORKER_MAX_SEGMENT_TEXT_CHARS=2000       # ký tự tối đa cho text/original_text mỗi segment
WORKER_MAX_TOTAL_TEXT_CHARS=200000       # tổng ký tự văn bản tối đa toàn job
WORKER_MAX_SEGMENT_META_CHARS=256        # ký tự tối đa cho field meta (id/speaker...) mỗi segment
